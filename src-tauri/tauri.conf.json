{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clara",
  "version": "1.0.0",
  "identifier": "com.hat.clara",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clara",
        "width": 1440,
        "height": 900,
        "minWidth": 1220,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "reminder",
        "title": "Clara 日程提醒",
        "url": "reminder.html",
        "width": 420,
        "height": 300,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "widget",
        "title": "Clara 桌面小部件",
        "url": "widget.html",
        "width": 360,
        "height": 540,
        "minWidth": 300,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/clara-backend"
    ]
  }
}
